<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnVoltarRelatorios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:backgroundTint="@color/cor_botoes"
            android:textColor="@color/cor_texto"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Relatórios financeiros"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/cor_texto"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnMesAnterior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:backgroundTint="@color/cor_botoes"/>

            <TextView
                android:id="@+id/txtMesRelatorio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mês"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cor_texto"/>

            <Button
                android:id="@+id/btnProximoMes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:backgroundTint="@color/cor_botoes"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txtReceitasRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Receitas: R$ 0,00"
            android:textSize="20sp"
            android:textColor="@color/cor_receita"/>

        <TextView
            android:id="@+id/txtDespesasRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Despesas: R$ 0,00"
            android:textSize="20sp"
            android:textColor="@color/cor_despesa"/>

        <TextView
            android:id="@+id/txtSaldoRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Saldo: R$ 0,00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/cor_texto"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Despesas por categoria"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/cor_texto"/>

        <LinearLayout
            android:id="@+id/listaCategoriasRelatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"/>

    </LinearLayout>

</ScrollView>
